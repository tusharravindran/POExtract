# Database Configuration
# For Render.com, these will be automatically set by the PostgreSQL service
# For local development, update these values

DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=poextract_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Flask Configuration
FLASK_DEBUG=False
PORT=5001

# Note: On Render.com, the database connection details will be provided
# via environment variables automatically when you link a PostgreSQL database
# to your web service. You can also use DATABASE_URL if provided by Render.
